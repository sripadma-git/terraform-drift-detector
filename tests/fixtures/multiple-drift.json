{
  "format_version": "1.2",
  "terraform_version": "1.15.8",
  "resource_drift": [
    {
      "address": "aws_instance.web",
      "type": "aws_instance",
      "change": {
        "actions": ["update"],
        "before": {
          "tags": {
            "Environment": "Production",
            "ManagedBy": "Terraform"
          }
        },
        "after": {
          "tags": {
            "Environment": "Development",
            "ManagedBy": "Manual"
          }
        }
      }
    },
    {
      "address": "aws_security_group.web",
      "type": "aws_security_group",
      "change": {
        "actions": ["update"],
        "before": {
          "ingress": [
            {
              "from_port": 443,
              "to_port": 443,
              "protocol": "tcp",
              "cidr_blocks": ["10.0.0.0/16"]
            }
          ]
        },
        "after": {
          "ingress": [
            {
              "from_port": 22,
              "to_port": 22,
              "protocol": "tcp",
              "cidr_blocks": ["0.0.0.0/0"]
            }
          ]
        }
      }
    }
  ],
  "resource_changes": []
}